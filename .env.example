# Database connection string (MongoDB Atlas for Vercel, or local mongodb://127.0.0.1:27017/saviny)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/saviny?retryWrites=true&w=majority

# Session encryption secret (min 32 characters)
SESSION_SECRET=saviny-super-secret-key-change-in-production-32-chars

# Google OAuth (Optional for local dev, required for Google Login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Gemini Generative AI (Used by Smart Savings Coach, Receipt Scanner, What-If simulation)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

